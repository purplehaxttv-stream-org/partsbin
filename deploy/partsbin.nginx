server {
    listen 80;
    server_name partsbin.purplehax.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name partsbin.purplehax.com;

    ssl_certificate /etc/letsencrypt/live/piwebserver/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/piwebserver/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5055;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
